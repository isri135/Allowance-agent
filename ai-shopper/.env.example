# Claude
ANTHROPIC_API_KEY=
SHOPPER_MODEL=claude-sonnet-5-5

# Channel3 (https://trychannel3.com)
CHANNEL3_API_KEY=

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# After approving, PayPal sends the buyer to a page the shopper serves at
# http://localhost:8765. Change the port if 8765 is taken:
# SHOPPER_RETURN_PORT=8765

# Shopping settings
SHOPPER_BUDGET=200
SHOPPER_CURRENCY=USD   # USD, CAD, GBP, AUD, EUR...
# SHOPPER_COUNTRY=US   # inferred from currency if unset
